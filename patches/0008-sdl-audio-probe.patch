 void sound_sdl::sink_callback(void *userdata, uint8_t *data, int len)
 {
 	stream_info *stream = reinterpret_cast<stream_info *>(userdata);
-	stream->m_buffer.get((int16_t *)data, len / 2 / stream->m_buffer.channels());
+	const uint32_t frames = len / 2 / stream->m_buffer.channels();
+	if(stream->m_audio_probe_enabled) {
+		const double now = SDL_GetPerformanceCounter() * stream->m_audio_tick_seconds;
+		stream->m_audio_probe.callback(frames, stream->m_buffer.available(), now);
+	}
+	stream->m_buffer.get((int16_t *)data, frames);
+}
+
+void sound_sdl::write_audio_probe(uint32_t id, const char *event, double now, const gunblade::AudioProbeRecord &r)
+{
+	if(!m_audio_log)
+		return;
+	std::fprintf(m_audio_log,
+		"AUDIO_PROBE stream=%u wall_s=%.6f event=%s seconds=%.6f pushes=%llu pushed_frames=%llu callbacks=%llu requested_frames=%llu missing_frames=%llu underrun_callbacks=%llu dropped_frames=%llu queue_min=%u queue_max=%u queue_end=%u max_push_gap_ms=%.3f max_callback_gap_ms=%.3f\n",
+		id, now, event, r.seconds,
+		static_cast<unsigned long long>(r.pushes), static_cast<unsigned long long>(r.pushed_frames),
+		static_cast<unsigned long long>(r.callbacks), static_cast<unsigned long long>(r.requested_frames),
+		static_cast<unsigned long long>(r.missing_frames), static_cast<unsigned long long>(r.underrun_callbacks),
+		static_cast<unsigned long long>(r.dropped_frames), r.queue_min, r.queue_max, r.queue_end,
+		r.max_push_gap_seconds * 1000.0, r.max_callback_gap_seconds * 1000.0);
+	std::fflush(m_audio_log);
 }
 
